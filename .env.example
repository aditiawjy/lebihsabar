# ───────────────────────────────────────────────────────────
# Contoh konfigurasi environment.
# Salin file ini menjadi `.env` lalu isi nilai yang sebenarnya.
# JANGAN commit file `.env` ke git (sudah masuk .gitignore).
# ───────────────────────────────────────────────────────────

# Database (dipakai oleh koneksi.php dan bridgebrowser/db.php)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nama_database
DB_USER=user_database
DB_PASSWORD=password_database

# Izinkan LOAD DATA LOCAL INFILE (1 = aktif, kosong/0 = nonaktif)
DB_ALLOW_LOCAL_INFILE=0

# Batas upload CSV (bytes) — default 5 MB
MAX_CSV_UPLOAD_BYTES=5242880

# Jumlah maksimal backup CSV yang disimpan
MAX_CSV_BACKUPS=20

{
  "manifest_version": 3,
  "name": "BPVM Scraper",
  "version": "1.0",
  "description": "Scraper for p1b3gp.bpvxncqr.com",
  "permissions": [
    "activeTab",
    "alarms",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://p1b3gp.bpvxncqr.com/*",
    "https://api.telegram.org/*",
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://p1b3gp.bpvxncqr.com/*"
      ],
      "js": [
        "lib/utils.js",
        "content.js"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BPVM Scraper"
  }
}
